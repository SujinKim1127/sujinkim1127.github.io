---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectTimeline from '../components/ProjectTimeline.astro';
import { GITHUB_URL, EMAIL } from '../consts';

const stack = [
  'React',
  'TypeScript',
  'Next.js',
  'Zustand',
  'useSWR',
  'TailwindCSS',
  'd3',
  'turboRepo',
];

const postypeProjects = [
  {
    period: '2026.08',
    title: 'Lexical 오픈소스 기여',
    problem:
      '에디터 오류 문의를 대응하던 중, iOS 자동 대문자화가 켜진 상태에서 Enter를 누르면 커서가 두 줄 밀리는 Lexical 내부 버그를 발견 (레포에 기존 이슈·PR 없음)',
    points: [
      [
        { t: 'iOS에서는 ' },
        { t: 'insertReplacementText', code: true },
        { t: '가 ' },
        { t: 'insertParagraph', code: true },
        { t: '보다 먼저 발생한다는 이벤트 순서 차이를 로그로 확인해 원인 파악' },
      ],
      'iOS에서만 커서 보정 로직을 건너뛰도록 최소한으로 수정한 뒤 테스트 작성',
      '수정 영상·테스트와 함께 facebook/lexical에 PR 제출',
    ],
    result: [
      { t: 'facebook/lexical ' },
      { t: 'v0.50.0에 머지', em: true },
      { t: ' · 릴리즈 New Contributors 등재' },
    ],
    links: [
      {
        text: '첫 오픈소스 기여기 (Lexical iOS 캐럿 버그)',
        href: '/posts/first-oss-contribution-lexical',
      },
    ],
  },
  {
    period: '2026.05 – 2026.07',
    title: 'Froala → Lexical 에디터 마이그레이션',
    problem:
      'Froala 에디터를 신기능 추가와 계류된 버그 해결을 위해 Lexical로 교체. Lexical 러닝 커브 비용 발생',
    points: [
      {
        text: '접근법 탐색·계획·구현·문제 해결 기록을 축적해 다음 작업을 가속하는 compound engineering 사용',
        sub: [
          '6종의 인용 노드 구현 중 커스텀 노드 타입명을 Lexical 기본값과 동일하게 지정해 노드가 생성되지 않는 충돌 발생하여 모든 커스텀 노드에 고유 타입명 규칙 수립',
          '앞선 작업을 기준 삼아 구분선 10종을 클래스 + 모양 값을 저장하는 노드로 설계해 기존 정렬/삭제 동작을 그대로 재현',
        ],
      },
    ],
    result: [
      { t: '예상보다 2주 빠른 ' },
      { t: '6주', em: true },
      { t: ' 만에 마이그레이션 완료, 이후 에디터 오류 발생 건수 월평균 ' },
      { t: '80% 감소', em: true },
    ],
    links: [
      {
        text: 'useSyncExternalStore로 Lexical EditorState를 툴바에 연결',
        href: '/posts/usesyncexternalstore-lexical-editorstate',
      },
    ],
  },
  {
    period: '2026.04',
    title: '댓글 모달 뒤로가기 UX 개선 & 백버튼 하이재킹 정책 대응',
    problem:
      '모바일 웹에서 댓글 모달을 뒤로가기로 닫으면 모달만 닫히지 않고 읽던 포스트까지 지나쳐 이전 페이지로 이탈. 모달은 히스토리에 기록이 없어 브라우저상 정상 동작이지만 사용자에겐 화면 이탈로 느껴짐',
    points: [
      '모달을 열 때 history에 항목을 추가해 뒤로가기가 모달만 닫도록 처리',
      'GA4로 "튕김(pogo)" 지표를 직접 정의(15초 이상 읽던 포스트에서 이탈 후 15초 내 복귀)해 효과 측정',
    ],
    result: [
      { t: '3시간 이동평균 기준 ' },
      { t: '전 시간대 튕김 감소', em: true },
      { t: ', 피크시간(22시) 튕김률 ' },
      { t: '약 19% 감소', em: true },
    ],
    links: [],
  },
];

const projects = [
  {
    period: '2025.07',
    title: '인포맥스 단말기 현재가 화면 성능 개선',
    problem:
      '주식 장 초반, 초당 수천 건의 실시간 데이터 유입으로 CPU 사용량 급상승 및 메모리 누수 발생, 단말기 사용 중 화면 지연 문제 빈번',
    points: [
      'react-virtualized를 사용하여 보이는 영역만 렌더링 되도록 가상화 처리',
      '실시간 데이터를 useRef + throttle 방식으로 Batching 처리하여 렌더링 최적화',
      'WebWorker로 데이터 연산 작업을 Worker에서 처리하여 메인 스레드 부하 감소',
    ],
    result: [
      { t: 'CPU 사용량 ' },
      { t: '약 50% 절감', em: true },
      { t: ', 메모리 누수 해소' },
    ],
    links: [],
  },
  {
    period: '2025.04 – 09',
    title: '금융솔루션 – ICAMS 프로젝트 (전담)',
    points: [
      'Atomic Design + FSD Architecture 도입하여 컴포넌트 구조 체계화',
      '엑셀처럼 resize, cell select(row, col 전체 선택 가능)이 가능한 그리드 제작',
      '재귀 기반 Infinite Accordion 컴포넌트 구현, 접힘 상태에 따른 그리드 데이터 동적 처리',
      '인턴으로서 프로젝트 메인 개발자로 배정되어 문제 상황을 파악하고 회의 제안',
      '데이터 팀과의 의사소통 비용을 해결하기 위해 Storybook으로 UI/인터랙션 테스트 문서화',
      '기획에서 누락된 UI 동작과 API 요구사항을 초기에 확정시켜 디자인 수정 건수를 감소시키고 개발 속도 향상',
    ],
    links: [
      {
        text: 'Component Architecture 정리',
        href: 'https://windy-museum-13d.notion.site/Component-Architecture-54ef754240104f3ba0f958355778fe38',
        external: true,
      },
    ],
  },
  {
    period: '2025.02 – 04',
    title: '스마일게이트 GMM/GMK ASP 개발 (PC/Mobile 개발)',
    points: [
      '구조는 같고 데이터만 다른 8개 페이지에 대응하기 위해, 공통 맵핑 로직을 Cursor를 사용해 함수 단위로 분리해서 자동화하여 작업 시간을 2시간에서 20분으로 단축',
    ],
    troubles: [
      {
        text: '양쪽 열에 고정된 헤더 그리드를 제작하며 발생한 오류 해결 과정기',
        href: '/posts/fixed-header-grid-error-troubleshooting',
      },
      {
        text: '일부 페이지에서 초기 우측 스크롤 미적용 현상 → ResizeObserver로 해결',
        href: '/posts/resizeobserver-force-scroll-right',
      },
    ],
    links: [],
  },
  {
    period: '2024.10 – 2025.01',
    title: 'Global Market Monitor 프로젝트 + 리팩토링',
    points: [
      'bitBucket과 사내메신저(두레이)를 연동하여 PR 알림 자동화',
      '라이브러리 대체로 번들 용량을 줄여 LightHouse 점수 63점에서 93점으로 개선',
      'agGrid를 react-virtualized로 변경, font 최적화 진행',
      '[한화투자증권] 기존 서비스 개편 사항 작업',
      '[메리츠] 파라미터 기반 다크모드 구조 설계/적용, 동일 구조를 [한화] 프로젝트에 제안·적용해 코드 재활용이 가능하도록 개선하여 유지보수성과 확장성 강화',
      '기존의 책임이 불분명한 Container/Presenter 구조를 Template, useFetches, useProcess로 분리하여 코드 가독성 개선',
    ],
    trouble: {
      problem: '초당 10회 이상 발생하는 동일 조회 요청으로 인한 서버 리소스 낭비',
      result: [
        { t: 'Redis로 서버사이드에서 캐싱 처리하여 중복 데이터 요청 방지 → 하루 10,000건 들어오던 서버 요청 800건으로 감소 ' },
        { t: '(약 92% 감소)', em: true },
      ],
    },
    links: [
      {
        text: 'agGrid를 react-virtualized로 변경',
        href: '/posts/aggrid-multigrid-infinite-scroll',
      },
    ],
  },
];

const awards = [
  { text: '2025 구름톤 16기 — 최우수상' },
  {
    text: '2023 서울 우먼 테크 해커톤 — 최우수상',
    href: 'https://drive.google.com/file/d/1xvGElaKvoKIYgRmrZtG4rYB_BavZffQr/view',
  },
  {
    text: '2023 숭실대학교 벤처스타트업 아카데미 SW경진대회 — 장려상',
    href: 'https://drive.google.com/file/d/1dy9z95uIQXb6WjTKXJcEDXEIWf679pHt/view',
  },
];

const education = [
  {
    period: '2019.03 – 2024.02',
    title: '숭실대학교 IT대학 글로벌미디어학부 · 컴퓨터학부 복수전공 학사',
  },
];

const activities = [
  { period: '2022.08 – 2023.09', title: 'GDSC Soongsil 2기 Web/Mobile' },
  { period: '2023.09 – 2023.12', title: 'Kusitms 28기 Web FrontEnd' },
  { period: '2023.11 – 2024.08', title: 'GDSC Soongsil 3기 Core member' },
  { period: '2024.07 – 2024.08', title: 'DND 11기 FrontEnd Developer' },
];
---

<BaseLayout title="소개" description="호기심으로 문제를 해결하며 성장하는 프론트엔드 개발자 김수진입니다.">
  <section class="intro">
    <p class="lede">
      사용자의 니즈를 읽고 직접 구현하는
      <strong>프론트엔드 엔지니어 김수진</strong>입니다.
    </p>
    <p class="intro-desc">
      '세상을 더 편리하게 만들고 싶다'는 마음으로 개발자를 꿈꾸며 컴퓨터공학을 전공했습니다. 취미로 콘텐츠를 리뷰하고 분석하는 계정을 3년 넘게 운영하며 구독자분들이 좋아하는 게시물을 파악해 팔로워 8천 명을 모았습니다.
    </p>
    <p class="intro-desc">
      사용자의 반응을 읽어서 니즈를 이해하는 일과 그것을 직접 구현하는 일 — 이 두 가지를
      동시에 할 수 있는 자리가 콘텐츠 플랫폼의 프론트엔드 엔지니어라고 생각합니다.
    </p>
    <div class="links">
      <a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
    </div>
  </section>

  <section class="about-section">
    <h2 class="section-heading">기술 스택</h2>
    <div class="stack">
      {stack.map((s) => <span class="chip">{s}</span>)}
    </div>
  </section>

  <section class="about-section">
    <h2 class="section-heading">경력</h2>

    <div class="career-company">
      <div class="career-head">
        <span class="career-org"><strong>포스타입</strong> · Frontend Engineer</span>
        <span class="career-period">2025.12 – 현재</span>
      </div>
      <p class="career-summary">
        크리에이터가 콘텐츠를 만들고 판매하며, 팬이 작품을 발견하고 구매·후원·참여하면서
        다음 창작을 함께 이어가는 창작 플랫폼
      </p>
      <ProjectTimeline projects={postypeProjects} />
    </div>

    <div class="career-company">
      <div class="career-head">
        <span class="career-org"><strong>연합인포맥스</strong> · FrontEnd Developer (인턴)</span>
        <span class="career-period">2024.09 – 2025.09</span>
      </div>
      <p class="career-summary">
        금융정보 기관과 개인투자자에게 금융 관련 뉴스, 실시간 금융 데이터, 분석 프로그램을
        전용 회선과 인터넷을 통해 전달하는 기업
      </p>
      <ProjectTimeline projects={projects} />
    </div>
  </section>

  <section class="about-section">
    <h2 class="section-heading">수상</h2>
    <ul class="plain-list plain-list--flush">
      {
        awards.map((a) => (
          <li>
            {a.text}
            {a.href && (
              <>
                {' '}
                <a class="award-link" href={a.href} target="_blank" rel="noopener">
                  발표자료
                </a>
              </>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="about-section">
    <h2 class="section-heading">학력</h2>
    <ul class="date-list">
      {
        education.map((e) => (
          <li>
            <span class="date-period">{e.period}</span>
            <span class="date-title">{e.title}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="about-section">
    <h2 class="section-heading">활동</h2>
    <ul class="date-list">
      {
        activities.map((a) => (
          <li>
            <span class="date-period">{a.period}</span>
            <span class="date-title">{a.title}</span>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
